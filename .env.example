# Local dev environment (D-10, D-11). Copy to `.env` and adjust as needed.
# Neon remains the staging/production target — these values point at the local
# docker-compose stack (`docker compose up -d`) so the API can run fully
# offline of Neon during device testing.

# ─── Database (packages/db, apps/api) ───────────────────────────
# Local compose Postgres (see docker-compose.yml). In staging/production this
# is the Neon pooled connection string instead.
DATABASE_URL=postgresql://festipal:festipal@localhost:5432/festipal
# drizzle-kit migrations + one-shot scripts (db:push/db:seed) prefer the direct
# (unpooled) URL (ADR-005) — against local Postgres this is the same value as
# DATABASE_URL since there is no pooler in dev.
DATABASE_URL_UNPOOLED=postgresql://festipal:festipal@localhost:5432/festipal

# ─── Auth (apps/api) ─────────────────────────────────────────────
# ADR-009: server-side signing secret for better-auth sessions. Generate your
# own — never reuse this placeholder, never commit a real value.
BETTER_AUTH_SECRET=<placeholder-generate-your-own>

# ─── OTP email transport (apps/api) ──────────────────────────────
# 'mailpit' routes OTP codes to the local Mailpit inbox (D-11) so a phone on
# the LAN can read the code during device testing. 'dev' (console + local
# capture file) and 'resend' (production) remain the other options.
OTP_EMAIL_TRANSPORT=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# ─── Mobile app (apps/mobile, plan 02) ───────────────────────────
# The Expo app's API base URL. This value is per-developer-machine (your LAN
# IP, not localhost — the phone is a separate device on the same Wi-Fi) and
# lives in apps/mobile's own env, not here. Documented for reference only:
# EXPO_PUBLIC_API_URL=http://<your-LAN-ip>:8081

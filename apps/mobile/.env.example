# D-10: the mobile app targets the local NestJS API over LAN Wi-Fi during dev
# (no HTTPS/Neon/Railway staging this phase). `EXPO_PUBLIC_*` vars are inlined
# into the JS bundle at build time by Expo — this is not a secret value.
#
# Replace <your-LAN-ip> with your dev machine's LAN IP (NOT localhost/127.0.0.1 —
# the physical test device is on the same Wi-Fi, not the same host). This value
# differs per developer machine/network, so it is never committed as `.env`.
EXPO_PUBLIC_API_URL=http://<your-LAN-ip>:8081

# API runtime
PORT=8081

# Neon Postgres — POOLED URL at runtime (see packages/db/.env.example)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/quiks?sslmode=require

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Email delivery (Resend) — optional; leave empty to use the dev console transport
RESEND_API_KEY=
OTP_EMAIL_TRANSPORT=dev

# Neon Postgres — DIRECT (unpooled) URL, used by drizzle-kit migrations + integration tests
DATABASE_URL_UNPOOLED=

ios/
android/
*.keystore
*.p8
*.p12
*.mobileprovision

# ─── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor / OS ────────────────────────────────────────────────
.idea/
.vscode/*
